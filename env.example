# ===========================================
# AMI One-on-One — environment template
# ===========================================
# cp env.example .env   (Prisma CLI reads .env only; Next.js reads .env and .env.local)
# Full reference with defaults and precedence: docs/ENV_VARIABLES.md

# ---------- Required ----------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ami_oneonone?schema=public"

# openssl rand -base64 32  (signs sessions)
NEXTAUTH_SECRET=""

# openssl rand -base64 32  (encrypts API keys saved in Admin -> Settings). Set in every environment.
# Rotation: move the old value to ENCRYPTION_SECRET_PREVIOUS, set a new ENCRYPTION_SECRET, run `npm run secrets:reencrypt`.
ENCRYPTION_SECRET=""
# ENCRYPTION_SECRET_PREVIOUS=""

# Exactly how users open the app. Local: http://localhost:3000  Prod: https://your-domain.com (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# "development" locally, "production" on the server
NODE_ENV="development"

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Redirect URI must be ${NEXTAUTH_URL}/api/auth/callback/google. Enable the Google Calendar API on the same project.
# The app refuses to boot if these are empty; placeholders are fine locally when using /api/auth/test-login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Required in production, strongly recommended elsewhere ----------
# Only accounts on this Workspace domain may sign in. Required in production (the app refuses to start without it).
GOOGLE_WORKSPACE_DOMAIN="whitelabeliq.com"

# Comma-separated emails promoted to SUPER_ADMIN on sign-in (first-admin bootstrap; never demotes).
INITIAL_ADMIN_EMAILS=""

# Shared secret for POST /api/cron/meetings (header x-cron-secret). Required in production; open in dev if unset.
CRON_SECRET=""

# ---------- AI (optional; can also be set in Admin -> Settings, which takes precedence) ----------
OPENAI_API_KEY=""

# ---------- AWS S3 (required for meeting recordings + attachments; can also be set in Admin -> Settings) ----------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ---------- Email (optional) ----------
# Option A: SMTP (used when SMTP_HOST, SMTP_USER, SMTP_PASSWORD and EMAIL_FROM are all set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
# Option B: AWS SES (used only when SMTP is not set; reuses AWS_ACCESS_KEY_ID/SECRET above)
AWS_SES_FROM_EMAIL=""

# ---------- Integrations (optional) ----------
# Fathom: Standard-Webhooks secret for POST /api/integrations/fathom/webhook (docs/FATHOM_ZOOM_SETUP.md)
FATHOM_WEBHOOK_SECRET=""

# Keka HR: approved leave + holidays block scheduling (docs/KEKA_INTEGRATION.md)
KEKA_ENVIRONMENT="keka"
KEKA_COMPANY=""
KEKA_CLIENT_ID=""
KEKA_CLIENT_SECRET=""
KEKA_API_KEY=""
KEKA_HOLIDAY_CALENDAR_ID_US=""
KEKA_HOLIDAY_CALENDAR_ID_IN=""

# ---------- Dev only ----------
# Enable POST /api/auth/test-login in production (never do this on a real server)
# ENABLE_TEST_LOGIN="false"
