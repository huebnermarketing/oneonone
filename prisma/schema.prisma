generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String              @id @default(uuid())
  email                        String              @unique
  name                         String              @default("")
  image                        String?
  emailVerified                DateTime?
  avatar                       String?
  role                         UserRole            @default(EMPLOYEE)
  reportsToId                  String?
  departmentId                 String?
  isActive                     Boolean             @default(true)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  bio                          String?
  phone                        String?
  title                        String?
  country                      String?
  timeZone                     String?
  workDayStart                 String?
  workDayEnd                   String?
  // Keka HR employee ID for leave/attendance integration
  kekaEmployeeId               String?
  // Keka-owned HR fields (lib/keka-sync.ts)
  employeeNumber               String?
  joiningDate                  DateTime?           @db.Date
  // Last time this user was matched in a Keka sync; null = never synced (manual / CSV user)
  kekaSyncedAt                 DateTime?
  accounts                     Account[]
  auditLogs                    AuditLog[]
  recordingJobsTriggered       RecordingJob[]      @relation("RecordingJobTrigger")
  meetingsAsEmployee           Meeting[]           @relation("EmployeeMeetings")
  meetingsAsReporter           Meeting[]           @relation("ReporterMeetings")
  notifications                Notification[]
  recurringSchedules           RecurringSchedule[] @relation("RecurringScheduleReporter")
  recurringSchedulesAsEmployee RecurringSchedule[] @relation("RecurringScheduleEmployee")
  sessions                     Session[]
  todosAssigned                Todo[]              @relation("AssignedTodos")
  todosCreated                 Todo[]              @relation("CreatedTodos")
  department                   Department?         @relation(fields: [departmentId], references: [id])
  reportsTo                    User?               @relation("ReportingHierarchy", fields: [reportsToId], references: [id])
  directReports                User[]              @relation("ReportingHierarchy")

  @@index([reportsToId])
  @@index([departmentId])
  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Meeting {
  id                       String             @id @default(uuid())
  employeeId               String
  reporterId               String
  meetingDate              DateTime
  /// Meeting length in minutes (15 or 30). Rows created before this column existed are 30.
  durationMinutes          Int                @default(15)
  checkInPersonal          String?
  checkInProfessional      String?
  priorityGoalProfessional String?
  priorityGoalAgency       String?
  progressReport           String?
  goodNews                 String?
  supportNeeded            String?
  priorityDiscussions      String?
  headsUp                  String?
  anythingElse             String?
  formSubmittedAt          DateTime?
  status                   MeetingStatus      @default(PROPOSED)
  proposedById             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  notes                    String?
  recurringScheduleId      String?
  meetingType              MeetingType        @default(IN_PERSON)
  meetingLink              String?
  zoomMeetingId            String?
  reminder24hSent          Boolean            @default(false)
  reminderSent             Boolean            @default(false)
  formReminderSent         Boolean            @default(false)
  attachments              Attachment[]
  calendarEvent            CalendarEvent?
  employee                 User               @relation("EmployeeMeetings", fields: [employeeId], references: [id])
  recurringSchedule        RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])
  reporter                 User               @relation("ReporterMeetings", fields: [reporterId], references: [id])
  recording                MeetingRecording?
  todos                    Todo[]

  @@index([employeeId])
  @@index([reporterId])
  @@index([meetingDate])
  @@index([status])
  @@index([recurringScheduleId])
  @@index([zoomMeetingId])
}

model Todo {
  id           String       @id @default(uuid())
  meetingId    String?
  assignedToId String
  createdById  String
  title        String
  description  String?
  dueDate      DateTime?
  priority     TodoPriority @default(MEDIUM)
  status       TodoStatus   @default(NOT_STARTED)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User         @relation("AssignedTodos", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedTodos", fields: [createdById], references: [id])
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([createdById])
  @@index([meetingId])
  @@index([status])
  @@index([dueDate])
}

model CalendarEvent {
  id                 String   @id @default(uuid())
  meetingId          String   @unique
  googleEventId      String   @unique
  googleCalendarLink String?
  scheduledAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([googleEventId])
}

model MeetingRecording {
  id             String          @id @default(uuid())
  meetingId      String          @unique
  audioUrl       String?
  audioKey       String?
  duration       Int?
  fileSize       Int?
  transcript     String?
  language       String?
  summary        String?
  keyPoints      Json?
  autoTodos      Json?
  sentiment      Json?
  qualityScore   Int?
  qualityDetails Json?
  status         RecordingStatus @default(UPLOADING)
  errorMessage   String?
  recordedAt     DateTime?
  processedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  meeting        Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  jobs           RecordingJob[]

  @@index([meetingId])
  @@index([status])
  @@index([language])
}

/// One row per pipeline run (initial processing or a reprocess). `MeetingRecording.status` stays the
/// user-facing status; this table is the audit trail + the lock that stops two runs on one recording.
model RecordingJob {
  id            String             @id @default(uuid())
  recordingId   String
  meetingId     String
  kind          RecordingJobKind
  /// Stage to start from; the pipeline skips earlier stages whose output already exists.
  fromStage     RecordingStage
  stage         RecordingStage     @default(COMBINE)
  status        RecordingJobStatus @default(QUEUED)
  attempt       Int                @default(1)
  error         String?
  totalChunks   Int?
  language      String?
  triggeredById String?
  startedAt     DateTime?
  heartbeatAt   DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  recording     MeetingRecording   @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  triggeredBy   User?              @relation("RecordingJobTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([recordingId])
  @@index([meetingId])
  @@index([status])
}

model SystemSettings {
  id                        String       @id @default("system")
  // ---- AI provider (Admin -> Settings -> AI Provider). One key; a model per job. ----
  aiProvider                AiProvider   @default(OPENAI)
  // API key for the selected provider (encrypted). Column keeps its historical name.
  openaiApiKey              String?
  // Model for analysis / insights (e.g. gpt-4o, or openai/gpt-4o on OpenRouter)
  openaiModel               String       @default("gpt-4o")
  // Cheaper model for high-volume, low-stakes calls (transcript search)
  aiFastModel               String       @default("gpt-4o-mini")
  // Speech-to-text model (whisper-1, or openai/whisper-1 on OpenRouter)
  whisperModel              String       @default("gpt-4o-transcribe")
  awsRegion                 String?
  awsAccessKeyId            String?
  awsSecretKey              String?
  awsS3Bucket               String?
  maxRecordingMins          Int          @default(25)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  enableEmailReminders      Boolean      @default(true)
  reminderHoursBefore       Int          @default(24)
  // ---- Policies (Admin -> Settings -> Policies) ----
  // When true, meeting cannot be marked Completed until the check-in form is submitted
  requireFormBeforeComplete Boolean      @default(true)
  // Who may cancel a single PROPOSED/SCHEDULED meeting. SUPER_ADMIN always can.
  cancelPolicy              CancelPolicy @default(REPORTER_AND_ADMIN)
  // When true, the employee in a meeting can open its recording, transcript and AI analysis
  employeeCanViewRecording  Boolean      @default(false)
  // When true, the employee can open the meeting's free-text notes written by the reporter
  employeeCanViewNotes      Boolean      @default(true)
  // Hours before a meeting for the second (short-notice) reminder; the first is reminderHoursBefore
  shortReminderHoursBefore  Int          @default(1)
  // Days 1:1s can be scheduled on (0 = Sunday … 6 = Saturday), in the scheduler's timezone
  workingDays               Int[]        @default([1, 2, 3, 4, 5])
  // Last successful Keka employee sync. Null = never run; the daily auto-sync only starts after an admin's first confirmed sync.
  kekaLastSyncAt            DateTime?
}

model RecurringSchedule {
  id                     String             @id @default(uuid())
  reporterId             String
  employeeId             String
  frequency              RecurringFrequency @default(BIWEEKLY)
  dayOfWeek              Int
  timeOfDay              String
  /// Length of each generated meeting in minutes (15 or 30)
  durationMinutes        Int                @default(15)
  meetingType            MeetingType        @default(IN_PERSON)
  meetingLink            String?
  isActive               Boolean            @default(true)
  nextMeetingDate        DateTime?
  lastGeneratedAt        DateTime?
  googleRecurringEventId String?
  googleCalendarLink     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  meetings               Meeting[]
  reporter               User               @relation("RecurringScheduleReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  employee               User               @relation("RecurringScheduleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([employeeId])
  @@index([isActive])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Attachment {
  id         String   @id @default(uuid())
  meetingId  String
  fileName   String
  fileType   String
  fileSize   Int
  s3Key      String
  s3Url      String?
  uploadedBy String
  createdAt  DateTime @default(now())
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model BackupHistory {
  id           String       @id @default(uuid())
  type         BackupType
  status       BackupStatus @default(PENDING)
  fileName     String?
  fileSize     Int?
  s3Key        String?
  tables       Json?
  recordCount  Json?
  createdBy    String?
  errorMessage String?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([startedAt])
}

enum UserRole {
  EMPLOYEE
  REPORTER
  SUPER_ADMIN
}

enum AiProvider {
  OPENAI
  OPENROUTER
}

enum CancelPolicy {
  ADMIN_ONLY
  REPORTER_AND_ADMIN
  ANY_PARTICIPANT
}

enum MeetingType {
  IN_PERSON
  ZOOM
}

enum MeetingStatus {
  PROPOSED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum TodoPriority {
  HIGH
  MEDIUM
  LOW
}

enum RecordingStatus {
  UPLOADING
  UPLOADED
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

enum RecordingJobKind {
  PROCESS
  REPROCESS
}

enum RecordingStage {
  COMBINE
  TRANSCRIBE
  ANALYZE
  DONE
}

enum RecordingJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationType {
  MEETING_REMINDER
  MEETING_SCHEDULED // legacy rows only; new events use the specific types below
  MEETING_PROPOSED
  MEETING_ACCEPTED
  MEETING_TIME_SUGGESTED
  MEETING_COMPLETED
  MEETING_CANCELLED
  SCHEDULE_UPDATED
  TODO_ASSIGNED
  TODO_DUE_SOON
  TODO_OVERDUE
  FORM_SUBMITTED
  FORM_REMINDER
  RECORDING_READY
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  CLEAR_DATA
  SETTINGS_CHANGE
}

enum BackupType {
  FULL
  PARTIAL
  SCHEDULED
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
